Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Le script de lancement est en Python 3 : ExtraContainerPackages garantit python3 dans le conteneur Debian 13. Le serveur (AppImage officielle extraite) n'a besoin d'aucun autre paquet.
